# 本地开发配置（本文件已被 .gitignore 忽略，不会进仓库）
FLASK_ENV=development
SECRET_KEY=local-dev-secret-change-before-deploy
JWT_SECRET=local-dev-jwt-secret-change-before-deploy

# 本机 MySQL 8.0：库 campus_service，账号 campus
DATABASE_URL=mysql+pymysql://campus:12345678@127.0.0.1:3306/campus_service?charset=utf8mb4

# 访问令牌 / 刷新令牌有效期（秒）
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# 登录接口限流：窗口秒数 / 窗口内最大请求数
LOGIN_RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT_MAX=10