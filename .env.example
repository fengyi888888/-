# 运行环境变量示例，复制为 .env 后按需修改
FLASK_ENV=development
SECRET_KEY=please-change-me-in-production
JWT_SECRET=please-change-me-too

# 生产环境使用 MySQL；测试环境自动回退到 SQLite 内存库
DATABASE_URL=mysql+pymysql://campus:campus_pwd@127.0.0.1:3306/campus_service?charset=utf8mb4

# 访问令牌 / 刷新令牌有效期（秒）
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# 登录接口限流：窗口秒数 / 窗口内最大请求数
LOGIN_RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT_MAX=10